{
  "env": {
    "GIT_CONFIG_GLOBAL": "/dev/null",
    "GIT_CONFIG_NOSYSTEM": "1",
    "GIT_TERMINAL_PROMPT": "0",
    "GIT_SSH_COMMAND": "false",
    "GCM_INTERACTIVE": "never",
    "SEMGREP_SEND_METRICS": "off"
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(echo FLEET_DENY_CANARY*)",
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(git merge *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git clone *)",
      "Bash(git ls-remote *)",
      "Bash(git send-pack *)",
      "Bash(git subtree *)",
      "Bash(git submodule *)",
      "Bash(git lfs *)",
      "Bash(git credential *)",
      "Bash(git config *)",
      "Bash(git -c *)",
      "Bash(git --config-env*)",
      "Bash(git --exec-path*)",
      "Bash(git * alias.*)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git remote remove *)",
      "Bash(git remote rm *)",
      "Bash(git remote rename *)",
      "Bash(git remote show *)",
      "Bash(git remote update *)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git restore *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(git commit --amend *)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git clean -x*)",
      "Bash(git branch -D *)",
      "Bash(git branch -M *)",
      "Bash(git checkout -f *)",
      "Bash(git checkout --force *)",
      "Bash(git checkout . *)",
      "Bash(git switch -f *)",
      "Bash(git switch --force *)",
      "Bash(git update-ref *)",
      "Bash(git reflog expire *)",
      "Bash(git reflog delete *)",
      "Bash(git gc *)",
      "Bash(git prune *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(gh *)",
      "Bash(hub *)",
      "Bash(glab *)",
      "Bash(sudo *)",
      "Bash(doas *)",
      "Bash(su *)",
      "Bash(pkexec *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(netcat *)",
      "Bash(socat *)",
      "Bash(telnet *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rsync *)",
      "Bash(aws *)",
      "Bash(gcloud *)",
      "Bash(az *)",
      "Bash(kubectl *)",
      "Bash(terraform *)",
      "Bash(docker *)",
      "Bash(podman *)",
      "Bash(systemctl *)",
      "Bash(service *)",
      "Bash(journalctl *)",
      "Bash(crontab *)",
      "Bash(tmux *)",
      "Bash(screen *)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(psql *)",
      "Bash(mysql *)",
      "Bash(supabase *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(python -m pip install *)",
      "Bash(python3 -m pip install *)",
      "Bash(uv pip install *)",
      "Bash(pipx *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci *)",
      "Bash(npm publish *)",
      "Bash(npx *)",
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(yarn install *)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -f *)",
      "Bash(dd *)",
      "Bash(shred *)",
      "Bash(mkfs*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(.envrc)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/**)",
      "Read(//proc/**)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(.git/**)",
      "Write(.git/**)",
      "Edit(.env)",
      "Write(.env)",
      "Edit(.env.*)",
      "Write(.env.*)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'F=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block_push.py\"; PY=$(command -v python3 || command -v python) || { echo \"hook block_push : python introuvable, blocage par defaut\" >&2; exit 2; }; [ -f \"$F\" ] || { echo \"hook block_push : script absent ($F), blocage par defaut\" >&2; exit 2; }; exec \"$PY\" \"$F\"'"
          }
        ]
      }
    ]
  }
}
