{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git pull:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git restore:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git commit --amend:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -d:*)",
      "Bash(git clean -x:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout -f:*)",
      "Bash(git checkout --force:*)",
      "Bash(git switch -f:*)",
      "Bash(git switch --force:*)",
      "Bash(git remote set-url:*)",
      "Bash(git remote remove:*)",
      "Bash(git remote rename:*)",
      "Bash(git update-ref -d:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo delete:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(netcat:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(rm -f:*)",
      "Bash(dd:*)",
      "Bash(shred:*)",
      "Bash(mkfs:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'PY=$(command -v python3 || command -v python) || { echo \"hook block_push : python introuvable, blocage par defaut\" >&2; exit 2; }; exec \"$PY\" .claude/hooks/block_push.py'"
          }
        ]
      }
    ]
  }
}
